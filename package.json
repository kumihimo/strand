{
  "name": "strand",
  "desktopName": "strand.desktop",
  "version": "0.1.2",
  "description": "An LLM-assisted SDLC for one engineer: a CLI, a Claude Code plugin and a local cockpit over Beads.",
  "license": "Apache-2.0",
  "author": "The Strand Authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumihimo/strand.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "strand": "src/cli/strand.ts"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "setup": "node installer/setup.ts",
    "build:ui": "vite build ui --outDir ../dist/ui --emptyOutDir",
    "cockpit": "node src/cli/strand.ts cockpit",
    "dev:ui": "vite ui",
    "app": "electron .",
    "package": "npm run build:ui && electron-builder --dir",
    "dist:win:unpacked": "electron-builder --win --x64 --dir --publish never",
    "dist:win:installer": "electron-builder --win nsis --x64 --prepackaged release/win-unpacked --publish never",
    "dist:linux": "electron-builder --linux deb AppImage --x64 --publish never"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "@fontsource-variable/geist": "5.3.0",
    "@napi-rs/keyring": "^2.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.11",
    "fastify": "^5.12.8",
    "lucide-react": "1.82.0",
    "node-pty": "1.1.0",
    "open": "^11.0.4",
    "openpgp": "^6.3.3",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@openpgp/web-stream-tools": "^0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "shadcn": "4.23.1",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  },
  "main": "electron/main.ts",
  "build": {
    "appId": "dev.strand.app",
    "productName": "Strand",
    "executableName": "strand",
    "asar": false,
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "kumihimo",
      "repo": "strand"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "electron/**/*.ts",
      "electron/preload.cjs",
      "electron/icon.png",
      "src/**/*.ts",
      "dist/ui/**/*",
      "RELEASE-KEY.asc"
    ],
    "icon": "electron/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "strand",
      "category": "Development",
      "maintainer": "The Strand Authors <authors@strand.invalid>"
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    }
  }
}
